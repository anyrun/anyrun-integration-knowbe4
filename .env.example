# =============================================================================
# Main settings
# =============================================================================
# PhishER GraphQL API endpoint. For example: `https://ca.knowbe4.com/graphql`.
PHISHER_ENDPOINT=put_phisher_graphql_api_endpoint_here
# PhishER product API token. See PhishER documentation for how to generate one.
PHISHER_API_TOKEN=put_phisher_product_api_token_here
# ANY.RUN Sandbox API-Key. See "Generate API token" section in the Documentation.
ANYRUN_API_KEY=put_anyrun_sandbox_api_key_here

# =============================================================================
# Proxy settings
# =============================================================================
# Routes requests to PhishER and ANY.RUN through a proxy. Use the format `http://[username:password@]host:port`. Leave empty to connect directly.
HTTP_PROXY=

# =============================================================================
# PhishER settings
# =============================================================================

# Tag that identifies messages for analysis. If empty, the connector processes all eligible unresolved messages that have not already been handled by the connector.
INGESTION_TAG=ANYRUN_REQUEST

# Optional additional Lucene filter applied together with `INGESTION_TAG`. Leave empty to apply no additional filtering.
PHISHER_MESSAGE_FILTER=

# Sets the PhishER message category to **Threat** when ANY.RUN returns a malicious verdict.
SET_CATEGORY_ON_MALICIOUS=true

# Maximum time, in seconds, to wait for a response from the PhishER API.
PHISHER_REQUEST_TIMEOUT=30

# =============================================================================
# ANY.RUN base settings
# =============================================================================
# ANY.RUN root domain used for API requests and links to analysis reports.
ANYRUN_ROOT_URL=any.run

# -----------------------------------------------------------------------------
# ANY.RUN analysis options
# -----------------------------------------------------------------------------
# Maximum analysis duration in seconds. Supported range: `10`-`1200`.
ANYRUN_OPT_TIMEOUT=240
# Analysis privacy level. Supported values: `public`, `bylink`, `owner`, and `byteam`. Availability depends on your ANY.RUN plan.
ANYRUN_PRIVACY_TYPE=bylink
# Enables network access in the analysis environment.
ANYRUN_OPT_NETWORK_CONNECT=true
# Enables FakeNet network simulation.
ANYRUN_OPT_NETWORK_FAKENET=false
# Routes analysis traffic through the Tor network.
ANYRUN_TOR=false
# Selects the Tor exit-node location. Use `fastest` or an available country code such as `US`.
ANYRUN_GEO=fastest
# Enables HTTPS traffic inspection using the ANY.RUN MITM proxy.
ANYRUN_MITM=false
# Routes analysis traffic through an ANY.RUN residential proxy.
ANYRUN_RESIDENTIAL_PROXY=false
# Selects the residential proxy location. Use `fastest` or an available country code.
ANYRUN_RESIDENTIAL_PROXY_GEO=fastest

# Number of attempts to retrieve the verdict after the analysis has finished.
ANYRUN_VERDICT_RETRY_ATTEMPTS=5
# Delay, in seconds, between verdict retrieval attempts.
ANYRUN_VERDICT_RETRY_DELAY_SECONDS=10

# -----------------------------------------------------------------------------
# ANY.RUN analysis object settings
# -----------------------------------------------------------------------------
# Automatically corrects the analyzed file's extension when necessary.
ANYRUN_OBJ_EXT_EXTENSION=true

# -----------------------------------------------------------------------------
# ANY.RUN analysis environment settings
# -----------------------------------------------------------------------------
# Language and regional settings of the analysis environment.
ANYRUN_ENV_LOCALE=en-US

# Please use one of the following environments at the same time.
# Default: Windows 10.

# --- Windows analysis environment (default) --------------------------------
# Operating system used for analysis. Supported values: `windows`, `linux`, and `macos`.
ANYRUN_OS_TYPE=windows
# Operating system version. Windows supports `7`, `10`, `11`, and `server 2025`. Linux supports `ubuntu`, `debian`, or compatible version values such as `22.04.2` and `12.2`.
ANYRUN_ENV_VERSION=10
# Windows environment architecture. Supported values: `32` and `64`.
ANYRUN_ENV_BITNESS=64
# Windows environment preset. Supported values: `complete` and `development`. The `development` preset is available only for Windows 10 x64.
ANYRUN_ENV_TYPE=complete
# Folder from which the analyzed object is started. Supported values depend on `ANYRUN_OS_TYPE`.
ANYRUN_OBJ_EXT_STARTFOLDER=temp
# Optional command-line arguments passed to the analyzed object. Leave empty to use the standard behavior.
ANYRUN_OBJ_EXT_CMD=
# Requests elevated privileges for supported Windows files. This option is not currently supported by the installed SDK version and is ignored.
ANYRUN_OBJ_FORCE_ELEVATION=false
# Enables automated interaction with the analyzed object.
ANYRUN_AUTOMATED_INTERACTIVITY=true

# --- Linux analysis environment ---------------------------------------------
# Operating system used for analysis. Supported values: `windows`, `linux`, and `macos`.
#ANYRUN_OS_TYPE=linux
# Operating system version. Windows supports `7`, `10`, `11`, and `server 2025`. Linux supports `ubuntu`, `debian`, or compatible version values such as `22.04.2` and `12.2`.
#ANYRUN_ENV_VERSION=22.04.2
# Folder from which the analyzed object is started. Supported values depend on `ANYRUN_OS_TYPE`.
#ANYRUN_OBJ_EXT_STARTFOLDER=temp
# Optional command-line arguments passed to the analyzed object. Leave empty to use the standard behavior.
#ANYRUN_OBJ_EXT_CMD=
# Requests superuser privileges in Linux. This option is not currently supported by the installed SDK version and is ignored.
#ANYRUN_RUN_AS_ROOT=false

# --- macOS analysis environment ---------------------------------------------
# Operating system used for analysis. Supported values: `windows`, `linux`, and `macos`.
#ANYRUN_OS_TYPE=macos
# Folder from which the analyzed object is started. Supported values depend on `ANYRUN_OS_TYPE`.
#ANYRUN_OBJ_EXT_STARTFOLDER=temp

# =============================================================================
# Redis settings
# =============================================================================
# Hostname of the Redis service used by the connector.
REDIS_HOST=redis
# Redis service port.
REDIS_PORT=6379
# Redis database number used by the connector.
REDIS_DB=0

# =============================================================================
# Job settings
# =============================================================================
# How often the connector checks PhishER for new messages, in seconds.
DISCOVERY_INTERVAL_SECONDS=300
# How often the connector checks the processing queue and attempts to submit messages to ANY.RUN, in seconds.
QUEUE_INTERVAL_SECONDS=30
# How often the connector checks for expired or stuck queue entries, in seconds.
CLEANUP_INTERVAL_SECONDS=300

# Maximum number of processing job instances that can run concurrently.
PROCESS_JOB_MAX_INSTANCES=50

# Maximum time, in seconds, that a message may remain queued or in progress before it is marked as timed out.
QUEUE_TIMEOUT_SECONDS=3600
# Redis expiration time, in seconds, for queue and in-progress records.
QUEUE_SAFETY_TTL_SECONDS=3600
# How long, in seconds, processed-message records are retained in Redis.
PROCESSED_TTL_SECONDS=3600

# Maximum number of PhishER messages requested per discovery page.
DISCOVERY_PER_PAGE=200
# Maximum number of queued messages handled in one processing batch.
QUEUE_PER_PAGE=50
# Maximum number of PhishER result pages checked during each discovery cycle.
MAX_DISCOVERY_PAGES=3

# =============================================================================
# Runtime/logging settings
# =============================================================================
# Logging detail level, for example `DEBUG`, `INFO`, `WARNING`, or `ERROR`.
LOG_LEVEL=INFO
# Directory where the connector stores its log files.
LOG_DIR=logs
# Maximum size of each log file before rotation. The default is 10 MB.
LOG_MAX_BYTES=10485760
# Number of rotated copies retained in addition to the active log file.
LOG_BACKUP_COUNT=2
