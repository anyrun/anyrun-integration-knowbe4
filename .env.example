# PhishER
PHISHER_ENDPOINT=https://ca.knowbe4.com/graphql
PHISHER_API_TOKEN=put_phisher_product_api_token_here

# Tag an admin applies in PhishER to opt a message into ANY.RUN scanning.
# Only messages carrying this tag are ingested by job 1.
# Set to empty to ingest every eligible non-resolved message instead (no opt-in required).
INGESTION_TAG=SEND_TO_ANYRUN

# Optional additional Lucene filter, ANDed together with the INGESTION_TAG check above.
# Empty or missing value means: no extra filtering beyond INGESTION_TAG.
PHISHER_MESSAGE_FILTER=

# ANY.RUN Sandbox
ANYRUN_API_KEY=put_anyrun_sandbox_api_key_here
# Windows version passed to ANY.RUN SDK for Windows download analysis.
# Supported values depend on SDK/account, commonly: 7, 10, 11, server 2025.
ANYRUN_WINDOWS_ENV_VERSION=10
ANYRUN_ROOT_URL=any.run

# The task-status stream can report a task as finished slightly before the
# verdict/scores are actually populated server-side. Retry fetching the
# verdict this many times, waiting this long between attempts, before
# giving up and tagging the message ANYRUN_ERROR.
ANYRUN_VERDICT_RETRY_ATTEMPTS=5
ANYRUN_VERDICT_RETRY_DELAY_SECONDS=10

# Redis (local queue state: msgs: / inprogress: / processed:)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Job intervals
DISCOVERY_INTERVAL_SECONDS=300
QUEUE_INTERVAL_SECONDS=30
CLEANUP_INTERVAL_SECONDS=300

# The process job (job 2) has no fixed one-at-a-time cap: each run checks
# available ANY.RUN slots itself and skips if none are free, so overlapping
# runs are expected and safe. This just bounds how many can pile up at once.
PROCESS_JOB_MAX_INSTANCES=50

# How long a message may sit in msgs:/inprogress: before cleanup reports a
# timeout back to PhishER, and how long processed: markers are retained.
QUEUE_TIMEOUT_SECONDS=3600
QUEUE_SAFETY_TTL_SECONDS=86400
PROCESSED_TTL_SECONDS=604800

# Batch sizes
DISCOVERY_PER_PAGE=200
QUEUE_PER_PAGE=50
MAX_DISCOVERY_PAGES=3

# Runtime
LOG_LEVEL=INFO
# Directory for rotating log files: scheduler.log (apscheduler) and app.log (everything else).
LOG_DIR=logs
# Each log file rotates at this size and keeps LOG_BACKUP_COUNT old copies
# plus the active file (2 -> 3 files on disk total per log).
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=2

